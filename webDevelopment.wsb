<Configuration>
  <!-- Web Development Environment -->
  <VGpu>Disable</VGpu>
  <Networking>Enable</Networking>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <ProtectedClient>Enable</ProtectedClient>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ClipboardRedirection>Enable</ClipboardRedirection>
  <MemoryInMB>6144</MemoryInMB>
  
  <!-- Scripts and development folder mapping -->
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Users\Public\Documents\SandboxScripts</HostFolder>
      <SandboxFolder>C:\Scripts</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Users\Public\WebProjects</HostFolder>
      <SandboxFolder>C:\WebProjects</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  
  <LogonCommand>
    <Command>C:\Scripts\installDevTools.cmd</Command>
  </LogonCommand>
</Configuration>